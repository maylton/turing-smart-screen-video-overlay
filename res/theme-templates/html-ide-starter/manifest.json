{
  "engine": "html",
  "name": "HTML IDE Starter",
  "version": 1,
  "display": {
    "width": 480,
    "height": 480
  },
  "refreshRate": 1,
  "entrypoint": "index.html",
  "overlayDocument": "overlays.json",
  "permissions": [
    "sensors"
  ],
  "network": false,
  "dataUpdateIntervals": {
    "default": 1,
    "system.hostname": 5,
    "cpu.temperature": 2,
    "cpu.usage": 1,
    "memory.usage": 2
  },
  "atomicRegions": [
    {
      "name": "overlay:custom-status",
      "x": 32,
      "y": 31,
      "width": 416,
      "height": 34
    },
    {
      "name": "overlay:turing-cpu-temperature-1",
      "x": 54,
      "y": 150,
      "width": 168,
      "height": 72
    },
    {
      "name": "overlay:turing-cpu-usage-bar-1",
      "x": 54,
      "y": 242,
      "width": 372,
      "height": 18
    },
    {
      "name": "overlay:turing-ram-usage-1",
      "x": 258,
      "y": 150,
      "width": 168,
      "height": 72
    }
  ]
}
