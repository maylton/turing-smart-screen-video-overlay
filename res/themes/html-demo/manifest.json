{
  "engine": "html",
  "name": "Material Sensor Orbit",
  "version": 2,
  "display": {
    "width": 480,
    "height": 480
  },
  "refreshRate": 2,
  "entrypoint": "index.html",
  "permissions": ["sensors"],
  "network": false,
  "dataUpdateIntervals": {
    "default": 5,
    "$sequence": 5,
    "$timestamp": 1,
    "system.time": 1,
    "cpu.usage": 2,
    "cpu.temperature": 5,
    "cpu.frequency": 5,
    "gpu.usage": 2,
    "gpu.temperature": 5,
    "gpu.vramUsed": 5,
    "gpu.vramTotal": 30,
    "memory.usage": 2,
    "memory.used": 5,
    "memory.total": 30,
    "network.download": 2,
    "network.upload": 2
  },
  "atomicRegions": [
    {"name": "clock", "x": 26, "y": 42, "width": 160, "height": 42},
    {"name": "cpu-reading", "x": 66, "y": 144, "width": 112, "height": 96},
    {"name": "cpu-frequency", "x": 238, "y": 150, "width": 200, "height": 42},
    {"name": "gpu-value", "x": 162, "y": 316, "width": 68, "height": 36},
    {"name": "gpu-bar", "x": 42, "y": 354, "width": 184, "height": 18},
    {"name": "gpu-meta", "x": 42, "y": 374, "width": 188, "height": 22},
    {"name": "memory-value", "x": 380, "y": 316, "width": 68, "height": 36},
    {"name": "memory-bar", "x": 260, "y": 354, "width": 184, "height": 18},
    {"name": "memory-meta", "x": 260, "y": 374, "width": 188, "height": 22},
    {"name": "download", "x": 24, "y": 436, "width": 105, "height": 24},
    {"name": "upload", "x": 178, "y": 436, "width": 105, "height": 24},
    {"name": "sequence", "x": 358, "y": 436, "width": 98, "height": 24}
  ]
}
