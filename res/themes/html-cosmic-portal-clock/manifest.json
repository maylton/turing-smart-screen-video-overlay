{
  "engine": "html",
  "name": "Cosmic Portal Clock",
  "version": 1,
  "display": {
    "width": 480,
    "height": 480
  },
  "refreshRate": 2,
  "entrypoint": "index.html",
  "permissions": ["sensors"],
  "network": false,
  "nativeVideoOverlay": {
    "enabled": true,
    "localPath": "cosmic-portal-background.mp4",
    "devicePath": "/mnt/SDCARD/video/cosmic-portal-background.mp4",
    "fps": 24,
    "duration": 8,
    "backgroundFrame": 0,
    "backgroundVideo": {
      "sourcePath": "assets/cosmic-portal-source.mp4",
      "fit": "cover",
      "position": "center",
      "loop": true,
      "startTime": 0
    }
  },
  "dataUpdateIntervals": {
    "default": 5,
    "$sequence": 5,
    "$timestamp": 1,
    "cpu.temperature": 1
  },
  "atomicRegions": [
    {"name": "date", "x": 112, "y": 70, "width": 256, "height": 48},
    {"name": "clock", "x": 68, "y": 154, "width": 344, "height": 124},
    {"name": "cpu-temperature", "x": 112, "y": 326, "width": 256, "height": 66}
  ]
}
