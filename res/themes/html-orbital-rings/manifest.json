{
  "engine": "html",
  "name": "Anéis Orbitais",
  "version": 1,
  "display": {"width": 480, "height": 480},
  "refreshRate": 1,
  "entrypoint": "index.html",
  "overlayDocument": "overlays.json",
  "permissions": ["sensors"],
  "network": false,
  "nativeVideoOverlay": {
    "enabled": true,
    "localPath": "html-orbital-rings.mp4",
    "devicePath": "/mnt/SDCARD/video/html-orbital-rings.mp4",
    "fps": 24,
    "duration": 4,
    "backgroundFrame": 0
  },
  "dataUpdateIntervals": {"default": 2, "$timestamp": 1}
}
