{
  "engine": "html",
  "name": "Digivice",
  "version": 1,
  "display": {
    "width": 480,
    "height": 480
  },
  "refreshRate": 1,
  "entrypoint": "index.html",
  "overlayDocument": "overlays.json",
  "permissions": [
    "sensors"
  ],
  "network": false,
  "nativeVideoOverlay": {
    "enabled": true,
    "localPath": "html-digivice.mp4",
    "devicePath": "/mnt/SDCARD/video/html-digivice.mp4",
    "fps": 24,
    "duration": 3,
    "backgroundFrame": 0
  },
  "dataUpdateIntervals": {
    "default": 2,
    "$timestamp": 1
  }
}
